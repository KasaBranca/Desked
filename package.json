{
  "name": "desked",
  "version": "1.0.0",
  "description": "Desked - self-hosted remote desktop web application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "install-service": "node scripts/install-service.js",
    "uninstall-service": "node scripts/uninstall-service.js",
    "create-task": "powershell.exe -ExecutionPolicy Bypass -File scripts/create-task.ps1"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "koffi": "^2.9.0",
    "sharp": "^0.33.5",
    "werift": "^0.22.9",
    "ws": "^8.18.0"
  }
}
