{
  "name": "desked",
  "version": "1.1.0",
  "description": "Desked - self-hosted remote desktop web application",
  "main": "server.js",
  "bin": {
    "desked": "cli.js"
  },
  "scripts": {
    "setup": "node cli.js setup",
    "start": "node cli.js start",
    "start:server": "node server.js",
    "password": "node cli.js password",
    "test": "node --test",
    "dev": "node --watch server.js",
    "install-service": "node cli.js install",
    "uninstall-service": "node cli.js uninstall",
    "create-task": "powershell.exe -ExecutionPolicy Bypass -File scripts/create-task.ps1"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "koffi": "^2.9.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.4",
    "ws": "^8.21.3"
  }
}
