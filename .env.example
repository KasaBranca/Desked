# Desked Configuration
# Generate/update this file with: npm run setup

# Server host (0.0.0.0 for all IPv4, :: for all IPv4/IPv6)
HOST=0.0.0.0
PORT=3389

# Password for authentication (REQUIRED - change this!)
PASSWORD=change_me_to_a_long_random_password

# Cloudflare Tunnel token. Leave empty to use a Quick Tunnel (default),
# which creates a temporary https://<random>.trycloudflare.com URL.
TUNNEL_TOKEN=

# Screen capture quality (1-100, lower = smaller files, faster)
CAPTURE_QUALITY=60

# Screen capture scale (0.1-1.0, lower = smaller resolution, faster)
CAPTURE_SCALE=0.6667

# Target frame rate (frames per second)
TARGET_FPS=10

# Low-latency video mode (requires FFmpeg)
STREAM_MODE=h264
H264_ENCODER=libx264
H264_TARGET_FPS=24
H264_CAPTURE_FPS=24
H264_GOP=24
H264_CQ=28
H264_DESKTOP_CAPTURE=0

# Session timeout in hours
SESSION_TIMEOUT_HOURS=24

# Max login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
LOCKOUT_MINUTES=15
